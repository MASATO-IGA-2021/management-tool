@startuml
' Define entities
entity "Users" as users {
  *user_id : INT
  --
  user_name : VARCHAR
  email : VARCHAR
  password : VARCHAR
  created_at : DATETIME
  updated_at : DATETIME
  is_active : BOOLEAN
}

entity "Products" as products {
  *product_id : INT
  --
  product_name : VARCHAR
  description : TEXT
  price : DECIMAL
  stock : INT
  created_at : DATETIME
}

entity "Orders" as orders {
  *order_id : INT
  --
  user_id : INT
  order_date : DATETIME
  total_amount : DECIMAL
}

entity "OrderDetails" as order_details {
  *order_detail_id : INT
  --
  order_id : INT
  product_id : INT
  quantity : INT
  price : DECIMAL
}

entity "Sessions" as sessions {
  *session_id : INT
  --
  user_id : INT
  token : VARCHAR
  created_at : DATETIME
  expires_at : DATETIME
}

' Define relationships
users ||--o{ orders : "注文する"
orders ||--o{ order_details : "contains"
products ||--o{ order_details : "included in"
users ||--o{ sessions : "ログインセッション"
@enduml