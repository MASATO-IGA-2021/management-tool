@startuml

class User {
    +String id // ユーザーの一意識別子
    +String username // ユーザー名
    +String hashedPassword // ハッシュ化されたパスワード
    +List<Project> projects // ユーザーが所属するプロジェクトのリスト
    +login() // ユーザーがログインするメソッド
    +logout() // ユーザーがログアウトするメソッド
    +signIn() // ユーザーがサインインするメソッド
    +editFeedback(Feedback feedback) // ユーザーがフィードバックを編集するメソッド
    +deleteFeedback(Feedback feedback) // ユーザーがフィードバックを削除するメソッド
    +editReviewCategory(ReviewCategory category) // ユーザーがレビューカテゴリを編集するメソッド
    +deleteReviewCategory(ReviewCategory category) // ユーザーがレビューカテゴリを削除するメソッド
}

class Project {
    +String id // プロジェクトの一意識別子
    +String projectName // プロジェクト名
    +List<User> members // プロジェクトのメンバーリスト
    +Date duration // プロジェクトの期間
    +List<Feedback> feedbacks // プロジェクトに関連するフィードバックのリスト
    +List<ReviewCategory> reviewCategories // プロジェクト内のReviewCategoryのリスト
}

class Feedback {
    +String id // フィードバックの一意識別子
    +Date reviewDate // レビューの日付
    +String reviewName // レビューの名前
    +String target // レビューの対象
    +User author // レビュワー
    +User assignee // 作業担当者
    +String reviewContent // レビューの内容
    +ReviewCategory reviewCategory // レビューのカテゴリ
    +String correctionStatus // 修正状況
    +saveFeedback() // フィードバックを保存するメソッド
    +saveDraft() // フィードバックを下書きとして保存するメソッド
}

class ReviewCategory {
    +String id // カテゴリの一意識別子
    +String categoryName // カテゴリ名
    +createCategory() // カテゴリを作成するメソッド
}

class ProjectService {
    +createProject(User user, Project project) // プロジェクトを作成するメソッド
    +addMember(Project project, User member) // プロジェクトにメンバーを追加するメソッド
    +viewProject(User user, Project project) // プロジェクトを閲覧するメソッド
}

class FeedbackService {
    +addFeedback(Project project, Feedback feedback) // フィードバックを追加するメソッド
    +viewFeedbacks(User user, Project project) // フィードバックを閲覧するメソッド
    +saveFeedback(Feedback feedback) // フィードバックを保存するメソッド
    +saveDraft(Feedback feedback) // フィードバックを下書きとして保存するメソッド
    +editFeedback(User user, Feedback feedback) // フィードバックを編集するメソッド
    +deleteFeedback(User user, Feedback feedback) // フィードバックを削除するメソッド
    +filterFeedbacks(Project project, String condition) // フィードバックをフィルタリングするメソッド
}

class ReviewCategoryService {
    +createReviewCategory(User user, Project project, ReviewCategory category) // ReviewCategoryを作成するメソッド
    +editReviewCategory(User user, ReviewCategory category) // レビューカテゴリを編集するメソッド
    +deleteReviewCategory(User user, ReviewCategory category) // レビューカテゴリを削除するメソッド
}

User "1" -- "0..*" Project : creates >
User "1" -- "0..*" Project : adds member >
Project "0..*" -- "0..*" Feedback : contains >
Project "0..*" -- "0..*" ReviewCategory : manages >
Feedback "1" -- "1" ReviewCategory : has >
Feedback "1" -- "1" User : author >
Feedback "1" -- "1" User : assignee >
ProjectService "1" -- "1" User : manages >
ProjectService "1" -- "0..*" Project : manages >
FeedbackService "1" -- "0..*" Feedback : manages >
ReviewCategoryService "1" -- "0..*" ReviewCategory : manages >

@enduml